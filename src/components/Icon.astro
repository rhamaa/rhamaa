---
interface Props { name: 'arrow' | 'external' | 'linkedin' | 'university' | 'book' | 'close'; }
const { name } = Astro.props;
---
<svg class={`icon icon--${name}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M3 12h17m-6-6 6 6-6 6" />}
  {name === 'external' && <><path d="M14 3h7v7m0-7L10 14"/><path d="M10 4H4v16h16v-6"/></>}
  {name === 'linkedin' && <><rect x="2" y="2" width="20" height="20" rx="2" fill="currentColor" stroke="none"/><path d="M7 10v7m4 0v-7m0 3c0-4 6-4 6 0v4" stroke="var(--color-teal)" stroke-width="2.2"/><circle cx="7" cy="7" r="1.2" fill="var(--color-teal)" stroke="none"/></>}
  {name === 'university' && <><path d="m2 8 10-6 10 6H2Zm1 12h18M2 22h20M5 10v8m5-8v8m4-8v8m5-8v8"/></>}
  {name === 'book' && <path d="M12 5c-3-3-7-3-10-2v16c3-1 7-1 10 2 3-3 7-3 10-2V3c-3-1-7-1-10 2v16Z"/>}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6" />}
</svg>
