---
interface Props {
  number: string;
  title: string;
  description?: string;
  id?: string;
}

const { number, title, description, id } = Astro.props;
---

<div class="section-heading">
  <span class="section-heading__number" aria-hidden="true">{number}</span>
  <div class="section-heading__copy">
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</div>
