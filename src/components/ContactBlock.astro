---
import ReferenceArt from './ReferenceArt.astro';
import Icon from './Icon.astro';
interface Props { linkedin: string; }
const { linkedin } = Astro.props;
---
<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="container contact-section__inner">
    <div class="contact-section__copy">
      <p class="eyebrow">Kontak <span class="node-line"></span></p><h2 id="contact-title">Mari <em>terhubung</em></h2>
      <p>Terbuka untuk berdiskusi, berkolaborasi, atau sekadar<br class="desktop-break" /> bertukar cerita tentang teknologi, pembelajaran, dan hal-hal bermakna lainnya.</p>
      <a class="button button--primary contact-button" href={linkedin} target="_blank" rel="noreferrer" aria-label="Terhubung dengan Firdaus Nuur Rhamadhan di LinkedIn"><Icon name="linkedin" />Terhubung di LinkedIn <Icon name="arrow" /></a>
    </div>
    <ReferenceArt kind="landscape" class="contact-section__art" />
  </div>
</section>
