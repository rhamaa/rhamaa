---
import LandscapeArt from './LandscapeArt.astro';
import Icon from './Icon.astro';
interface Props { linkedin: string; }
const { linkedin } = Astro.props;
---
<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="container contact-section__inner">
    <div class="contact-section__copy">
      <p class="eyebrow">Contact <span class="node-line"></span></p><h2 id="contact-title">Let's <em>connect</em></h2>
      <p>Open to conversations, collaboration, or simply<br class="desktop-break" /> sharing ideas about technology, learning, and meaningful work.</p>
      <a class="button button--primary contact-button" href={linkedin} target="_blank" rel="noreferrer" aria-label="Connect with Firdaus Nuur Rhamadhan on LinkedIn"><Icon name="linkedin" />Connect on LinkedIn <Icon name="arrow" /></a>
    </div>
    <LandscapeArt class="contact-section__art" />
  </div>
</section>
