---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectTimeline from '../components/ProjectTimeline.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import portfolio from '../data/portfolio.json';
const featuredProjects = portfolio.projects.filter((project) => project.featured);
---
<BaseLayout title="Firdaus Nuur Rhamadhan — Rhamaa | IoT, AI & Software" description="Portfolio of Firdaus Nuur Rhamadhan (Rhamaa), working across IoT, software, AI, and computer vision.">
  <SiteNav />
  <main id="main-content">
    <Hero profile={portfolio.profile} linkedin={portfolio.contact.linkedin} />
    <section class="projects-section container" id="projects" aria-labelledby="projects-title">
      <div class="projects-heading">
        <div><p class="section-index"><span></span>04</p><h2 id="projects-title">Selected projects</h2><p class="section-intro">A few projects I'm building and exploring as I work<br class="desktop-break" /> toward more useful and meaningful solutions.</p></div>
        <p class="projects-heading__aside">From idea and research to implementation.<br />Every project is a chance to learn<br />and keep moving forward.</p>
      </div>
      <div class="projects-grid">{featuredProjects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}</div>
      <div class="section-signature"><span></span><p>IDEA <b>—</b> DESIGN <b>—</b> IMPLEMENTATION <b>—</b> IMPACT</p></div>
    </section>
    <section class="timeline-section" id="timeline" aria-labelledby="timeline-title">
      <svg class="journey-lines" viewBox="0 0 550 250" aria-hidden="true"><path d="M0 210c70 0 95-20 145-20 90 0 85-77 170-72 90 4 77-150 180-87 25 15 40 30 55 33M70 210c100-15 90-40 180-47 80-7 110-132 180-83 40 28 60 62 120 55M250 210c85-4 91 21 155 20 79-2 99 18 145 20"/><circle cx="324" cy="99" r="11"/></svg>
      <div class="container timeline-section__inner">
        <p class="eyebrow eyebrow--teal">Journey <span></span></p><h2 id="timeline-title">Project journey</h2>
        <p class="section-intro timeline-section__intro">From device integration to prototypes built with sensors,<br class="desktop-break" /> computer vision, and AI—leading to monitoring systems<br class="desktop-break" /> and software products that I'm continuing to explore.</p>
        <ProjectTimeline timeline={portfolio.timeline} projects={portfolio.projects} />
      </div>
    </section>
    <section class="about-section container" id="about" aria-labelledby="about-title">
      <div class="about-heading"><div><p class="eyebrow">Experience & education <span class="node-line"></span></p><h2 id="about-title">Experience & education</h2></div><p class="section-intro">Learning and collaboration have shaped how I approach<br class="desktop-break" /> problems, build solutions, and keep growing<br class="desktop-break" /> as an engineer.</p></div>
      <ExperienceList experience={portfolio.experience} education={portfolio.education} />
    </section>
    <ContactBlock linkedin={portfolio.contact.linkedin} />
  </main>
  <footer class="site-footer"><div class="container site-footer__inner"><a class="footer-wordmark" href="#home">RHAMAA</a><p>TECHNOLOGY FOR A BETTER WORLD</p><a class="footer-top" href="#home">BUILT WITH CURIOSITY <span class="node-line"></span></a></div></footer>
</BaseLayout>
